DATABASE_URL="file:./dev.db"
# At least 32 characters. Required when running a production build.
SESSION_SECRET="replace-this-with-a-long-random-session-secret"
# Mock login is intentionally available for the hackathon. Disable before real deployment.
DEMO_LOGIN_ENABLED="true"
# Optional. The ranking engine works without an LLM.
LLM_API_KEY=""
LLM_BASE_URL="https://api.openai.com/v1"
LLM_MODEL="gpt-4.1-mini"
