generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}
model Employee {
  id           String @id
  employeeId   String @unique
  name         String
  role         String
  grade        String
  department   String @default("Engineering")
  tenureMonths Int
  targetRole   String
  targetGrade  String
  skills       EmployeeSkill[]
  history      ActivityHistory[]
  recommendations Recommendation[]
}
model Skill {
  id        String @id
  skillCode String @unique
  name      String
  category  String
  employees EmployeeSkill[]
  requirements GradeRequirement[]
  gains     EventSkillGain[]
  missions  MissionSkill[]
}
model EmployeeSkill {
  employeeId String
  skillId    String
  level      Int
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  skill      Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)
  @@id([employeeId, skillId])
}
model GradeRequirement {
  id            String @id @default(cuid())
  role          String
  grade         String
  skillId       String
  requiredLevel Int
  weight        Float
  skill         Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)
  @@unique([role, grade, skillId])
}
model Event {
  id               String @id
  eventCode        String @unique
  name             String
  type             String
  category         String
  description      String
  hours            Int
  businessPriority Float
  minTenureMonths  Int @default(0)
  gains            EventSkillGain[]
  history          ActivityHistory[]
  recommendations  Recommendation[]
}
model EventSkillGain {
  eventId  String
  skillId  String
  gain     Int
  maxLevel Int
  event    Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  skill    Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)
  @@id([eventId, skillId])
}
model ActivityHistory {
  id          String @id @default(cuid())
  employeeId  String
  eventId     String
  status      String
  completedAt DateTime?
  createdAt   DateTime @default(now())
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  event       Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  @@unique([employeeId, eventId])
}
model Recommendation {
  id          String @id @default(cuid())
  employeeId  String
  eventId     String
  score       Float
  explanation String
  fingerprint String
  createdAt   DateTime @default(now())
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  event       Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  @@unique([employeeId, eventId])
}
model Mission {
  id          String @id
  eventId     String @unique
  name        String
  description String
  duration    Int
  commitment  Int
  skills      MissionSkill[]
}
model MissionSkill {
  missionId     String
  skillId       String
  requiredLevel Int
  mission       Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)
  skill         Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)
  @@id([missionId, skillId])
}
