{
  "name": "halyk-talentos",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/app.mjs dev",
    "build": "prisma generate && node scripts/app.mjs build",
    "start": "node scripts/app.mjs start",
    "db:setup": "node scripts/setup.mjs && prisma generate && prisma migrate deploy && tsx data/prisma/seed.ts",
    "db:seed": "tsx data/prisma/seed.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test",
    "test:http": "node tests/api/smoke.mjs",
    "format": "prettier --write \"apps/**/*.{ts,tsx,css,mjs,json}\" \"packages/**/*.ts\" \"data/**/*.ts\" \"tests/**/*.{ts,mjs}\" \"scripts/*.mjs\" \"*.{json,ts,mts,mjs,md}\" \"docs/**/*.md\" \".github/**/*.yml\"",
    "lint": "eslint apps packages data tests scripts --max-warnings=0"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/manrope": "^5.2.8",
    "@prisma/client": "^6.12.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.0",
    "lucide-react": "^0.468.0",
    "next": "16.3.6",
    "papaparse": "^5.5.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.1.2",
    "tailwind-merge": "^3.3.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.12",
    "@types/node": "^22.18.0",
    "@types/papaparse": "^5.3.16",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.6",
    "prettier": "^3.6.2",
    "prisma": "^6.12.0",
    "tailwindcss": "^4.1.12",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^4.1.11"
  },
  "workspaces": [
    "apps/frontend",
    "apps/backend",
    "packages/*"
  ],
  "prisma": {
    "schema": "data/prisma/schema.prisma"
  }
}
